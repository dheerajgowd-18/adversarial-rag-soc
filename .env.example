# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file — it is in .gitignore.

# ============================================================
# LLM API KEYS
# ============================================================

# Groq (Free tier — use for Phases 0-3)
# Sign up at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (Optional — use for Phase 4+ if upgrading)
# Sign up at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Optional — alternative for Phase 4+)
# Sign up at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# MODEL SELECTION
# ============================================================

# Lock this once you choose your model in Phase 4.
# Options: llama-3.1-8b-instant, llama-3.3-70b-versatile (Groq)
#          claude-haiku-3-5, claude-sonnet-4-5 (Anthropic)
#          gpt-4o-mini (OpenAI)
LLM_MODEL=llama-3.1-8b-instant
LLM_PROVIDER=groq

# Cheap model for defense secondary LLM calls (Phase 8)
# Should be smaller/faster than the main triage model
DEFENSE_LLM_MODEL=llama-3.1-8b-instant
DEFENSE_LLM_PROVIDER=groq

# ============================================================
# PATH CONFIGURATION
# ============================================================

# ChromaDB paths
CHROMA_CLEAN_PATH=data/chroma_clean
CHROMA_POISONED_PATH=data/chroma_poisoned

# Alert store paths
CLEAN_ALERTS_PATH=data/alerts/clean_alerts.json
SUSPICIOUS_QUEUE_PATH=data/alerts/suspicious_queue.json
EVAL_FIXED_SET_PATH=data/alerts/eval_fixed_set.json

# ============================================================
# PIPELINE CONFIGURATION
# ============================================================

# Number of alerts to process (reduce for testing, use full set for paper)
MAX_ALERTS=1000

# RAG retrieval top-k per collection
RETRIEVAL_TOP_K=3

# Defense flag (set to false to run baseline/attack conditions)
DEFENSE_ACTIVE=false
